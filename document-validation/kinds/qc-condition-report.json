{
  "$schema": "./kind.schema.json",
  "kindId": "qc-condition-report",
  "jurisdiction": "QC",
  "label": {
    "fr": "Constat de l'état des lieux",
    "en": "Dwelling condition report"
  },
  "family": "residential-lease",
  "declaredAs": [
    "CONDITION_REPORT",
    "OTHER"
  ],
  "signals": [
    {
      "id": "title",
      "weight": 2,
      "pattern": "(?i)[ée]tat\\s+des\\s+lieux|dwelling\\s+condition\\s+(?:report|checklist)|(?:move-?in|move-?out)\\s+(?:and\\s+move-?out\\s+)?inspection"
    },
    {
      "id": "rooms",
      "weight": 1,
      "pattern": "(?is)\\b(?:cuisine|kitchen)\\b.{0,800}?\\b(?:salle\\s+de\\s+bains?|bathroom)\\b"
    },
    {
      "id": "condition-line",
      "weight": 1,
      "pattern": "(?i)\\b(?:[ée]tat|condition)\\s*:"
    },
    {
      "id": "keys",
      "weight": 1,
      "pattern": "(?i)remise\\s+des\\s+cl[ée]s|keys\\s+handed\\s+over"
    }
  ],
  "jurisdictionHints": [
    {
      "id": "tal",
      "weight": 1,
      "pattern": "(?i)tribunal\\s+administratif\\s+du\\s+logement|housing\\s+tribunal"
    },
    {
      "id": "ccq",
      "weight": 1,
      "pattern": "C\\.c\\.Q\\.|(?i:code\\s+civil\\s+du\\s+qu[ée]bec)|(?i:civil\\s+code\\s+of\\s+qu[ée]bec)"
    },
    {
      "id": "postal-code",
      "weight": 1,
      "pattern": "\\b[A-HJ-NPR-TVXY]\\d[A-HJ-NPR-TV-Z] ?\\d[A-HJ-NPR-TV-Z]\\d\\b"
    },
    {
      "id": "place",
      "weight": 1,
      "pattern": "\\b(?:Qu[ée]bec|Montr[ée]al|Laval)\\b"
    }
  ],
  "excludes": [],
  "dateSignals": [
    {
      "id": "inspection-date",
      "pattern": "(?i)(?:date\\s+de\\s+l['’]inspection|date\\s+of\\s+(?:the\\s+)?inspection|inspection\\s+date)\\s*:?\\s*(\\d{4}-\\d{2}-\\d{2}|\\d{1,2}(?:er)?\\s+[A-Za-zÀ-ÿ]+\\s+\\d{4}|[A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})"
    }
  ],
  "asOfFrom": "inspection-date",
  "retrieval": {
    "targets": [
      {
        "instrument": "CCQ-1991",
        "refs": [
          "1893",
          "1900",
          "1910",
          "1911"
        ]
      }
    ],
    "question": {
      "fr": "Quels articles encadrent l'état des lieux et la remise d'un logement au Québec ?",
      "en": "Which articles govern the condition report and the delivery of a dwelling in Québec?"
    }
  },
  "ruleset": "qc-condition-report",
  "status": "PROMOTED",
  "fixtures": [
    {
      "file": "fixtures/qc-condition-report/fr-filled.txt",
      "expect": "MATCH",
      "form": "FILLED",
      "language": "fr",
      "documentDate": "2026-09-01"
    },
    {
      "file": "fixtures/qc-condition-report/en-filled.txt",
      "expect": "MATCH",
      "form": "FILLED",
      "language": "en",
      "documentDate": "2026-09-01"
    },
    {
      "file": "fixtures/qc-condition-report/fr-blank.txt",
      "expect": "MATCH",
      "form": "BLANK",
      "language": "fr",
      "documentDate": null
    },
    {
      "file": "fixtures/qc-condition-report/en-blank.txt",
      "expect": "MATCH",
      "form": "BLANK",
      "language": "en",
      "documentDate": null
    },
    {
      "file": "fixtures/qc-condition-report/no-match-lease-mentioning-it.txt",
      "expect": "NO_MATCH"
    }
  ]
}
