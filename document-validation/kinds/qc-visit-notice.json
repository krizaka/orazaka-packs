{
  "$schema": "./kind.schema.json",
  "kindId": "qc-visit-notice",
  "jurisdiction": "QC",
  "label": {
    "fr": "Avis de visite (24 heures)",
    "en": "Visit notice (24 hours)"
  },
  "family": "residential-lease",
  "declaredAs": [
    "NOTICE",
    "OTHER"
  ],
  "signals": [
    {
      "id": "title",
      "weight": 2,
      "pattern": "(?i)avis\\s+(?:de\\s+)?(?:visite|d['’]acc[eè]s)|notice\\s+of\\s+(?:a\\s+)?(?:visit|entry)|(?:visit|entry)\\s+notice"
    },
    {
      "id": "24h",
      "weight": 1,
      "pattern": "(?i)\\b24\\s*h(?:eures)?\\b|\\bvingt-quatre\\s+heures|\\btwenty-four\\s+hours|\\b24[\\s-]+hours\\b"
    },
    {
      "id": "reason",
      "weight": 1,
      "pattern": "(?i)motif\\s+de\\s+la\\s+visite|reason\\s+for\\s+the\\s+(?:visit|entry)"
    },
    {
      "id": "articles-1931-1933",
      "weight": 1,
      "pattern": "(?i)\\bart(?:icles?|\\.)?\\s*193[123]\\b"
    }
  ],
  "jurisdictionHints": [
    {
      "id": "tal",
      "weight": 1,
      "pattern": "(?i)tribunal\\s+administratif\\s+du\\s+logement|housing\\s+tribunal"
    },
    {
      "id": "ccq",
      "weight": 1,
      "pattern": "C\\.c\\.Q\\.|(?i:code\\s+civil\\s+du\\s+qu[ée]bec)|(?i:civil\\s+code\\s+of\\s+qu[ée]bec)"
    },
    {
      "id": "postal-code",
      "weight": 1,
      "pattern": "\\b[A-HJ-NPR-TVXY]\\d[A-HJ-NPR-TV-Z] ?\\d[A-HJ-NPR-TV-Z]\\d\\b"
    },
    {
      "id": "place",
      "weight": 1,
      "pattern": "\\b(?:Qu[ée]bec|Montr[ée]al|Laval)\\b"
    }
  ],
  "excludes": [
    "(?i)loyer\\s+mensuel[^.\\n]{0,40}\\d",
    "(?i)monthly\\s+rent[^.\\n]{0,40}\\d"
  ],
  "dateSignals": [
    {
      "id": "notice-date",
      "pattern": "(?i)(?:date\\s+de\\s+l['’]avis|date\\s+of\\s+(?:the\\s+)?notice|notice\\s+date|fait\\s+le)\\s*:?\\s*(\\d{4}-\\d{2}-\\d{2}|\\d{1,2}(?:er)?\\s+[A-Za-zÀ-ÿ]+\\s+\\d{4}|[A-Za-z]+\\s+\\d{1,2},?\\s+\\d{4})"
    }
  ],
  "asOfFrom": "notice-date",
  "retrieval": {
    "targets": [
      {
        "instrument": "CCQ-1991",
        "refs": [
          "1931",
          "1932",
          "1933"
        ]
      }
    ],
    "question": {
      "fr": "Quels articles régissent un avis de visite d'un logement au Québec ?",
      "en": "Which articles govern a notice of visit to a dwelling in Québec?"
    }
  },
  "ruleset": "qc-visit-notice",
  "status": "PROMOTED",
  "fixtures": [
    {
      "file": "fixtures/qc-visit-notice/fr-filled.txt",
      "expect": "MATCH",
      "form": "FILLED",
      "language": "fr",
      "documentDate": "2026-10-20"
    },
    {
      "file": "fixtures/qc-visit-notice/en-filled.txt",
      "expect": "MATCH",
      "form": "FILLED",
      "language": "en",
      "documentDate": "2026-10-20"
    },
    {
      "file": "fixtures/qc-visit-notice/fr-blank.txt",
      "expect": "MATCH",
      "form": "BLANK",
      "language": "fr",
      "documentDate": null
    },
    {
      "file": "fixtures/qc-visit-notice/en-blank.txt",
      "expect": "MATCH",
      "form": "BLANK",
      "language": "en",
      "documentDate": null
    },
    {
      "file": "fixtures/qc-visit-notice/no-match-lease-with-visit-clause.txt",
      "expect": "NO_MATCH"
    }
  ]
}
