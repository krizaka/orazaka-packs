{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document validation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "version",
    "documentType",
    "expectedIssuers",
    "acceptedProducers",
    "acceptedProducerClasses",
    "expectedFields",
    "pageCount",
    "fontCount"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "documentType": {
      "type": "string",
      "enum": ["pay-stub", "bank-statement", "employment-letter"]
    },
    "expectedIssuers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptedProducers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptedProducerClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["editor", "generator", "ocr", "scanner"]
      }
    },
    "expectedFields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "pageCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "fontCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
